// DataStream Command Center — data model.
//
// Command Flow (Phase 2) has no QueueItem table: its queue is computed live
// by merging AttentionFlag + InboxItem + RunbookItem queries, so there's
// nothing to keep in sync. See lib/services/commandFlow.ts.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Inbox Command
// ---------------------------------------------------------------------------

enum InboxStatus {
  NEW
  TRIAGED
  WAITING
  DELEGATED
  SNOOZED
  DONE
}

// AI-assigned tags (see lib/services/inboxClassification.ts) — never
// used to compute a KPI or invented fact, only to sort/label mail
// already synced from Graph. Category is "what kind of ask is this,"
// Urgency is "how soon does it need you" — orthogonal axes, an
// APPROVAL can be either ATTENTION_TODAY or DECISION depending on
// deadline pressure.
enum InboxCategory {
  CLIENT
  APPROVAL
  INTERNAL
  SALES
  OTHER
}

enum InboxUrgency {
  ATTENTION_TODAY
  DECISION
  DELEGATABLE
  INFORMATIONAL
  NEWSLETTER
}

model InboxItem {
  id             String      @id @default(cuid())
  graphMessageId String      @unique
  sender         String
  senderEmail    String
  subject        String
  preview        String
  bodyPreviewUrl String?
  receivedAt     DateTime
  status         InboxStatus @default(NEW)
  delegateNote   String?
  delegatedToId  String?
  delegatedTo    StaffUser?  @relation(fields: [delegatedToId], references: [id])
  waitingSince   DateTime?
  snoozedUntil   DateTime?
  isNoise        Boolean     @default(false)
  clearedAt      DateTime?

  // Set once at sync time by classifyNewInboxItems (inboxClassification.ts)
  // and never re-run on an already-tracked item — same "a re-sync can't
  // undo a decision" rule syncInboxFromGraph already follows for status.
  // All null when Anthropic isn't connected or a classification batch
  // failed; every reader must treat null as "unclassified," not crash.
  category     InboxCategory?
  urgency      InboxUrgency?
  brief        String?
  actionTitle  String?
  dueDate      DateTime?
  dollarAmount Float?
  classifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([receivedAt])
}

enum InboxRuleMatchType {
  SENDER_CONTAINS
  SUBJECT_CONTAINS
  DOMAIN
}

enum InboxRuleAction {
  ARCHIVE
  DEPRIORITIZE
}

model InboxRule {
  id         String             @id @default(cuid())
  name       String
  matchType  InboxRuleMatchType
  matchValue String
  action     InboxRuleAction
  enabled    Boolean            @default(true)
  createdAt  DateTime           @default(now())
}

// ---------------------------------------------------------------------------
// Auth (Microsoft Graph)
// ---------------------------------------------------------------------------

// Stores the serialized MSAL token cache (contains the refresh token),
// encrypted at rest — never the plaintext token, never in .env.
model OAuthToken {
  id             String   @id @default(cuid())
  provider       String   @unique
  accountEmail   String
  encryptedCache String
  scope          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// The Entra app registration's own credentials (as opposed to OAuthToken,
// which is the resulting per-mailbox connection). Singleton row, id fixed
// so upserts never need a lookup first. Secret encrypted the same way the
// refresh token cache is — never stored or returned in plaintext.
model MicrosoftAppCredential {
  id                    String   @id @default("microsoft")
  clientId              String
  tenantId              String
  encryptedClientSecret String
  updatedAt             DateTime @updatedAt
}

// QuickBooks Online app registration (Intuit Developer app) — same role
// MicrosoftAppCredential plays for Graph. Unlike NinjaRMM, this is a real
// confidential client (Intuit issues a client secret), and needs an
// environment flag since sandbox/production use different API hosts.
model QuickBooksCredential {
  id                    String   @id @default("quickbooks")
  environment           String   @default("sandbox")
  clientId              String
  encryptedClientSecret String
  updatedAt             DateTime @updatedAt
}

// The per-connection QuickBooks OAuth result (authorization-code flow).
// realmId is the QuickBooks company ID, returned on the callback
// alongside the code — every API call needs it. Unlike NinjaRMM's
// refresh token (which stays the same call to call), QuickBooks rotates
// the refresh token on every refresh — lib/auth/quickbooksOAuth.ts always
// overwrites it.
model QuickBooksOAuthToken {
  id                    String   @id @default("quickbooks")
  realmId               String
  encryptedAccessToken  String
  encryptedRefreshToken String
  accessTokenExpiresAt  DateTime
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Keap (CRM/Sales, Phase C) API Application credentials — OAuth2
// authorization-code + refresh-token grant, confidential client (has a
// secret), same two-table split as QuickBooks above: this row is the
// app registration, KeapOAuthToken below is the per-login connection.
model KeapCredential {
  id                    String   @id @default("keap")
  clientId              String
  encryptedClientSecret String
  updatedAt             DateTime @updatedAt
}

model KeapOAuthToken {
  id                    String   @id @default("keap")
  encryptedAccessToken  String
  encryptedRefreshToken String
  accessTokenExpiresAt  DateTime
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// HaloPSA API Application credentials (OAuth2 client-credentials grant — no
// user login step, so saving valid credentials here is what "connects" it).
// Same singleton + encrypted-secret pattern as MicrosoftAppCredential.
model HaloPsaCredential {
  id                    String   @id @default("halopsa")
  instanceUrl           String
  clientId              String
  encryptedClientSecret String
  updatedAt             DateTime @updatedAt
}

// NinjaRMM API Application registration (Client ID/base URL, optional
// secret). Confirmed live against this account, twice: (1)
// client_credentials is unavailable — no such grant type offered when
// creating the app, "unauthorized_client" end to end; (2) the "Add
// client app" wizard itself shows no Client Secret field at all — this
// account's authorization-code apps are PKCE public clients (RFC 7636),
// confirmed against NinjaOne's own separate "Authorization Code Flow
// with PKCE" docs page. encryptedClientSecret is kept nullable/optional
// rather than removed, in case some accounts do get a confidential
// (secret-bearing) app type — lib/auth/ninjaRmmOAuth.ts uses PKCE
// regardless of whether one is present. Same app-registration role
// MicrosoftAppCredential plays for Microsoft Graph; the per-login
// connection itself lives in NinjaRmmOAuthToken below.
model NinjaRmmCredential {
  id                    String   @id @default("ninjarmm")
  apiBaseUrl            String
  clientId              String
  encryptedClientSecret String?
  updatedAt             DateTime @updatedAt
}

// The per-login NinjaRMM connection (authorization-code result). No MSAL
// involved here (Azure-specific), so unlike OAuthToken's single
// serialized cache blob, this stores the access/refresh token pair and
// expiry explicitly — lib/auth/ninjaRmmOAuth.ts owns refreshing it.
model NinjaRmmOAuthToken {
  id                    String   @id @default("ninjarmm")
  encryptedAccessToken  String
  encryptedRefreshToken String
  accessTokenExpiresAt  DateTime
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// United Cloud (Hosted PBX, iplogin/NetSapiens API) credentials. The API
// key itself is the bearer token — no OAuth exchange, no separate client
// ID — so this is simpler than HaloPSA/Microsoft but the same singleton +
// encrypted-secret pattern.
model UnitedCloudCredential {
  id               String   @id @default("unitedcloud")
  apiBaseUrl       String
  domain           String
  encryptedApiKey  String
  updatedAt        DateTime @updatedAt
}

// Anthropic API key for the Business Health chat. Same singleton +
// encrypted-secret pattern as UnitedCloudCredential — the API key is the
// bearer credential, no OAuth exchange. Deliberately NOT an env var: every
// other integration in this app is entered on /integrations and stored
// encrypted, and this one is no different. `model` is stored (not
// hardcoded) so it can move to a newer Sonnet without a migration, and is
// shown on the Integrations card so what's running is never a mystery.
model AnthropicCredential {
  id              String   @id @default("anthropic")
  model           String   @default("claude-sonnet-5")
  encryptedApiKey String
  updatedAt       DateTime @updatedAt
}

// Sherweb (Microsoft CSP/distributor — M365, Keeper, Nerdio licensing).
// Vendor Licensing Phase 1: credential plumbing only, no sync yet. No
// instanceUrl like HaloPSA — Sherweb's Service Provider API is a fixed
// global endpoint (api.sherweb.com), not per-tenant. Client ID is not
// secret on its own (same reasoning as HaloPsaCredential.clientId), but
// the secret and subscription key are both encrypted the same way.
model SherwebCredential {
  id                       String   @id @default("sherweb")
  clientId                 String
  encryptedClientSecret    String
  encryptedSubscriptionKey String
  updatedAt                DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

enum TicketPriority {
  P1
  P2
  P3
  P4
}

model TicketSnapshot {
  id             String         @id @default(cuid())
  haloTicketId   String         @unique
  haloClientId   String?
  // Raw client_name off the ticket itself — confirmed live to be
  // reliably populated (50/50 open tickets on a real sync) and already
  // on the same cheap list endpoint this app fetches, so this is a
  // simpler, more available source than joining against the Client
  // table (which only has rows for clients that have gone through the
  // separate Client Profitability sync). Null only for genuinely
  // client-less tickets (e.g. an automated vendor-alert ticket).
  clientName     String?
  summary        String
  status         String
  priority       TicketPriority
  assignedTech   String
  department     String
  // Raw tickettype_id off the ticket list response (e.g. 5 = "Project",
  // 20 = "Project Task", confirmed live via /api/TicketType) — used to
  // exclude project-tracking tickets from Manager Alerts/Needs Attention
  // (see PROJECT_TICKET_TYPE_IDS, lib/integrations/halopsa.ts). Nullable
  // since a ticket synced before this field existed, or one HaloPSA
  // omits the field for, shouldn't be treated as any particular type.
  ticketTypeId   Int?
  openedAt       DateTime
  // Kept as-is (merged respondbydate-or-fixbydate fallback) — existing
  // consumers (Dispatch pane's SLA countdown, the >24h SLA_BREACH flag,
  // the chat tool) all read this field and stay untouched. The three
  // fields below are additive, sourced from the same HaloPSA sync pass,
  // and carry the real underlying values *un-merged* — Response SLA and
  // Resolution SLA need to know respond-by and fix-by separately, not
  // whichever HaloPSA field happened to be set.
  slaDueAt       DateTime?
  // respondbydate raw (response target) and fixbydate raw (resolution
  // target) — confirmed both present on the live ticket list endpoint,
  // no extra API call needed beyond the sync this app already does.
  respondByAt    DateTime?
  fixByAt        DateTime?
  // responsedate raw — HaloPSA's own first-response timestamp. Confirmed
  // live to carry the identical value as the ticket *detail* endpoint's
  // first_responsedate field (cross-checked against a real ticket), but
  // — unlike first_responsedate — already present on the cheap list
  // endpoint this app already fetches, so Response SLA / Median First
  // Response need zero additional HaloPSA requests.
  respondedAt    DateTime?
  // lastactiondate raw — used for stale-ticket detection. This is *any*
  // update (including automated/customer ones), not specifically a
  // technician action — HaloPSA doesn't expose "last technician action"
  // without a per-ticket Actions fetch, which stale-ticket detection
  // deliberately avoids (see getStaleTickets in operations.ts) to stay
  // cheap enough to run on every page load. Treat as an honest
  // approximation, not an exact "technician touched this" signal.
  lastActionAt   DateTime?
  lastUpdatedAt  DateTime

  attentionFlags AttentionFlag[]

  @@index([status])
  @@index([assignedTech])
}

// A closed ticket leaves TicketSnapshot entirely (reconcileTickets in
// halopsa.ts deletes it — TicketSnapshot only ever mirrors HaloPSA's
// *currently open* feed) — so without this table, "tickets closed today"
// and Resolution SLA would have nothing to measure against. Written once,
// right before a ticket's TicketSnapshot row is deleted, carrying
// whatever fields were already cached locally (no extra HaloPSA call).
// closedAt is *sync detection time* (when this app noticed the ticket
// left the open feed), not HaloPSA's own exact resolution instant — on
// this app's every-page-load sync cadence that's normally within
// minutes, but it's labeled honestly as detection time, not claimed as
// precise. "Closed" here specifically means "no longer in HaloPSA's
// open_only=true feed" — the overwhelming majority of the time that's a
// real resolution, but it could technically also mean the ticket was
// merged into another one (HaloPSA's merged_into_id field exists,
// unconfirmed whether merged tickets also leave the open feed the same
// way) — not distinguished here.
model TicketCloseLog {
  id           String         @id @default(cuid())
  haloTicketId String         @unique
  clientName   String?
  summary      String
  priority     TicketPriority
  assignedTech String
  department   String
  openedAt     DateTime
  respondByAt  DateTime?
  fixByAt      DateTime?
  respondedAt  DateTime?
  closedAt     DateTime
  createdAt    DateTime       @default(now())

  @@index([closedAt])
}

enum AttentionSource {
  TICKET
  INBOX
  MANUAL
}

enum AttentionType {
  ESCALATION
  SLA_BREACH
  CEO_REVIEW
  OTHER
}

enum AttentionStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model AttentionFlag {
  id           String          @id @default(cuid())
  source       AttentionSource
  sourceId     String?
  ticketId     String?
  ticket       TicketSnapshot? @relation(fields: [ticketId], references: [id])
  type         AttentionType
  description  String
  status       AttentionStatus @default(OPEN)
  assignedTo   String?
  snoozedUntil DateTime?
  createdAt    DateTime        @default(now())
  resolvedAt   DateTime?

  @@unique([ticketId, type])
  @@index([status])
}

enum TimeGapRole {
  TECH
  ADMIN
}

model TimeGap {
  id             String      @id @default(cuid())
  person         String
  role           TimeGapRole
  expectedHours  Float
  loggedHours    Float
  periodStart    DateTime
  periodEnd      DateTime

  @@unique([person, periodStart])
  @@index([person])
}

// Per-day breakdown of TimeGap's weekly loggedHours total — same source
// (HaloPSA Actions, computed in computeWeeklyHoursByTech) bucketed by day
// instead of summed for the whole week. Persisted (not computed live at
// read time) for the same reason TimeGap is: the Actions fan-out is
// expensive and throttled, so the sync writes both the weekly total and
// the daily buckets in one pass rather than re-deriving one from the
// other on every page load. date is midnight-normalized, Mon-Fri only
// (see lib/dateUtils.ts's business-week convention) — TECH role only,
// no admin/billing equivalent requested yet.
model DailyHours {
  id        String   @id @default(cuid())
  person    String
  date      DateTime
  hours     Float
  updatedAt DateTime @updatedAt

  @@unique([person, date])
  @@index([person])
}

// Weekly snapshot of each tech's P1/aging/open/on-hold ticket counts —
// unlike TicketSnapshot (always current/live state, overwritten on every
// HaloPSA sync), this is a point-in-time record kept every week so a
// later week can show a real "vs last week" trend for Ticket Health
// (see TechOrgLastWeek in techPerformance.ts). No external API call
// involved in populating this — it's a snapshot of getLoadPerTech()'s
// own output (already derived from the already-synced TicketSnapshot
// table), so writing it is cheap enough to do on every page load, same
// cost profile as TimeGap/DailyHours. Builds up honestly from whenever
// this shipped forward — no backfilled history, same "label by the
// actual window, don't fake depth" approach as Client Profitability's
// rolling average.
model TicketLoadWeekly {
  id          String   @id @default(cuid())
  person      String
  periodStart DateTime
  periodEnd   DateTime
  openCount   Int
  p1Count     Int
  agingCount  Int
  onHoldCount Int
  updatedAt   DateTime @updatedAt

  @@unique([person, periodStart])
  @@index([person])
}

// Daily snapshot of the Service Desk Health Score and the headline KPIs
// it's built from — Phase 10 (Trends). Unlike ServiceDeskHealthSnapshot
// (always recomputed live from current TicketSnapshot/TicketCloseLog
// state, see serviceDeskHealth.ts), this is the one place that state gets
// frozen so a later day can show a real "vs 7 days ago" trend and a
// history chart. One row per calendar day, upserted on every page load
// (see syncServiceDeskHealthDaily) — same cost profile as
// TicketLoadWeekly, since every field here is already computed by
// getServiceDeskHealthSnapshot before this write happens, no new query or
// external call. Builds up honestly from whenever this shipped forward —
// no backfilled history, same "label by the actual window, don't fake
// depth" approach as TicketLoadWeekly/ClientMonthlyHours. All score
// fields are nullable because computeHealthScore's own categories can be
// null when a category has no data yet (see HealthScoreCategory) — a
// missing score here means "unavailable that day," not zero.
model ServiceDeskHealthDaily {
  id                  String   @id @default(cuid())
  date                DateTime @unique

  healthScore         Int?
  responsivenessScore Int?
  resolutionScore     Int?
  workloadScore       Int?
  phoneScore          Int?

  responseSlaPct      Float?
  resolutionSlaPct    Float?
  ticketsCreated      Int
  ticketsClosed       Int
  netChange           Int
  backlogTotal        Int
  agingOver24h        Int
  phoneAnswerRatePct  Float?

  updatedAt           DateTime @updatedAt
}

// Daily snapshot of each technician's Performance Score — the per-tech
// counterpart to ServiceDeskHealthDaily above, same rules: one row per
// (person, date), upserted on every page load from a score
// computeTechPerformanceScore already produced (see syncTechScoreDaily in
// techPerformanceScore.ts), never backfilled, nullable score fields
// because a category can be null when it has no data yet (see
// TechScoreCategory).
model TechScoreDaily {
  id                   String   @id @default(cuid())
  person               String
  date                 DateTime

  score                Int?
  serviceDeliveryScore Int?
  qualityScore         Int?
  productivityScore    Int?
  workManagementScore  Int?
  phoneScore           Int?

  updatedAt            DateTime @updatedAt

  @@unique([person, date])
  @@index([person])
}

// ---------------------------------------------------------------------------
// Shared delegation log (Inbox Command + Operations)
// ---------------------------------------------------------------------------

enum DelegationSource {
  INBOX
  OPERATIONS
  RUNBOOK
}

enum DelegationStatus {
  PENDING
  IN_PROGRESS
  DONE
}

model DelegationLog {
  id        String           @id @default(cuid())
  source    DelegationSource
  sourceId  String
  note      String
  status    DelegationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([source, sourceId])
}

// ---------------------------------------------------------------------------
// Runbooks
// ---------------------------------------------------------------------------

enum RunbookFrequency {
  ONE_OFF
  DAILY
  WEEKLY
  MONTHLY
}

model RunbookCategory {
  id    String        @id @default(cuid())
  name  String        @unique
  order Int           @default(0)
  items RunbookItem[]
}

// Due-ness is computed (see lib/services/runbooks.ts), not stored: archivedAt
// set means "done forever" (one-off items); otherwise due if lastCompletedAt
// is null or older than the frequency's interval.
model RunbookItem {
  id              String           @id @default(cuid())
  categoryId      String
  category        RunbookCategory  @relation(fields: [categoryId], references: [id])
  title           String
  description     String?
  frequency       RunbookFrequency @default(ONE_OFF)
  lastCompletedAt DateTime?
  snoozedUntil    DateTime?
  archivedAt      DateTime?
  createdAt       DateTime         @default(now())

  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Focus Mode
// ---------------------------------------------------------------------------

model FocusSession {
  id              String    @id @default(cuid())
  task            String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  completed       Boolean   @default(false)

  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// Client Profitability (HaloPSA clients, agreements, time)
// ---------------------------------------------------------------------------

// hoursThisMonth is recomputed on every sync from HaloPSA Actions — no
// historical time-entry ledger yet, matches the report's current-month
// scope. Revisit if a trend view is ever needed.
//
// ninjaOrganizationId/quickbooksCustomerId are manual cross-system links
// (no shared ID exists across HaloPSA/NinjaRMM/QuickBooks) — set via the
// Company Profile page's "Link accounts" panel, not auto-matched, since
// they feed real financial numbers.
model Client {
  id                   String   @id @default(cuid())
  haloClientId         String   @unique
  name                 String
  hoursThisMonth       Float    @default(0)
  ninjaOrganizationId  String?
  quickbooksCustomerId String?
  updatedAt            DateTime @updatedAt

  agreementItems AgreementItem[]
  techHours      ClientTechHours[]
  monthlyHours   ClientMonthlyHours[]
  financials     ClientFinancials?
  seatChecks     SeatReconciliation[]
  laborMonthly   ClientLaborMonthly[]
}

// Recomputed on every sync (no historical ledger), same pattern as
// Client.hoursThisMonth. Raw QuickBooks Invoices/Items/Purchases are
// fetched live and aggregated here, not persisted — same as HaloPSA
// Actions already work for hoursThisMonth.
model ClientFinancials {
  id               String   @id @default(cuid())
  clientId         String   @unique
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  revenueThisMonth Float    @default(0)
  laborCost        Float    @default(0)
  itemCost         Float    @default(0)
  itemRevenue      Float    @default(0)
  netProfit        Float    @default(0)
  updatedAt        DateTime @updatedAt
}

// Monthly snapshot of the "Service" agreement line (see
// categorizeAgreementItem — model/field names below still say "labor",
// the UI calls it "Service"; not renamed to avoid a migration for a
// pure display-text change) against real hours and the admin-set rate —
// powers Client Profitability's Effective Hourly Rate and Service
// Profit widgets, each with a 12-month trend. One row written per
// (client, current yearMonth) every time syncClientProfitability runs
// (lib/integrations/haloClients.ts); never backfilled for past months —
// HaloPSA's RecurringInvoice only ever reflects *today's* pricing, so
// there is no honest way to know what a line item cost 6 months ago.
// Same "builds up real history from today forward, no fabricated past"
// pattern as ServiceDeskHealthDaily/TechScoreDaily/ClientMonthlyHours.
// hourlyRateUsed/hoursThisMonth are frozen at write time so a later
// change to KpiSettings.laborHourlyRate doesn't retroactively rewrite
// already-recorded months.
model ClientLaborMonthly {
  id        String @id @default(cuid())
  clientId  String
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  yearMonth String // "YYYY-MM"

  laborLineValue Float // this month's Service agreement value

  // Managed Essential IT ÷ trailing-3-month average hours — null (not 0)
  // when there isn't yet a full trailing window to average.
  avgHoursLastQuarter Float?
  effectiveHourlyRate Float?

  hoursThisMonth Float // frozen copy of Client.hoursThisMonth at write time
  hourlyRateUsed Float // frozen copy of KpiSettings.laborHourlyRate at write time
  laborCost      Float // hoursThisMonth × hourlyRateUsed
  laborProfit    Float // laborLineValue - laborCost

  updatedAt DateTime @updatedAt

  @@unique([clientId, yearMonth])
  @@index([clientId])
}

// One row per (client, tool) — NinjaRMM's installed count for that tool
// vs. the quantity billed on the matching HaloPSA agreement item.
// Antivirus only for now (the only NinjaRMM signal confirmed available);
// the shape is generic so a second tool is a small extension later.
model SeatReconciliation {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tool           String
  installedCount Int
  billedQuantity Float
  updatedAt      DateTime @updatedAt

  @@unique([clientId, tool])
}

model AgreementItem {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  contractType String?
  quantity     Float    @default(1)
  // Real per-unit recurring price from HaloPSA's /api/RecurringInvoice
  // line items (unit_price), not the contract itself — /api/ClientContract
  // never exposes pricing (confirmed live). Null for a contract with no
  // matching active recurring invoice line (e.g. a one-time/T&M
  // engagement) — never fabricated, never defaulted to 0.
  unitPrice    Float?
  // Real per-unit wholesale cost from HaloPSA's own /api/Item catalog
  // (costprice), joined via each recurring invoice line's _itemid —
  // confirmed live to be genuinely populated for resold products (e.g.
  // "Fortress Security 2025 | Advanced Security" costprice=13.62,
  // "DataStream Protect | Virtual Machine Server" costprice=28.99), not
  // just a stub field. Null when unpriced or the catalog item has no
  // cost on file — never defaulted to 0, which would fabricate 100%
  // margin. Not meaningful for the Service category (its cost is hours
  // × the admin-set rate, not a purchased good — see ClientLaborMonthly),
  // so it's simply null/0 there.
  unitCost     Float?
  createdAt    DateTime @default(now())

  @@index([clientId])
}

// Hours by tech, per client, this month — recomputed on every sync from
// HaloPSA Actions, same "no historical ledger" pattern as
// Client.hoursThisMonth. Powers the tech-breakdown line on the Client
// Profitability dashboard.
model ClientTechHours {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tech      String
  hours     Float
  updatedAt DateTime @updatedAt

  @@unique([clientId, tech])
  @@index([clientId])
}

// Persisted monthly hours ledger, one row per (client, calendar month) —
// unlike hoursThisMonth/ClientTechHours (recomputed live from open tickets
// on every page load), this is the only place historical months are kept.
// It exists because a rolling average needs closed tickets too, and
// re-fetching those on every request isn't viable: HaloPSA's /api/Tickets
// hard-caps at 1000 rows with no working pagination, so backfilling it is
// an explicit, user-triggered action (see backfillClientMonthlyHours /
// POST /api/clients/sync-history), not something that runs automatically.
// On a busy instance that 1000-row cap may only reach back a few weeks,
// not a full year — the rolling-average UI labels itself by whatever date
// range actually got backfilled rather than assuming 12 months exist.
model ClientMonthlyHours {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  yearMonth String   // "YYYY-MM", sortable as a string
  hours     Float
  updatedAt DateTime @updatedAt

  @@unique([clientId, yearMonth])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Call Activity (United Cloud / iplogin hosted PBX CDRs)
// ---------------------------------------------------------------------------

// One row per synced Call Detail Record. CDRs are immutable history, so
// sync only ever upserts — never deletes/reconciles like TicketSnapshot
// does. `missed` is derived at sync time from whether answeredAt is set,
// not trusted from a single guessed vendor field.
model CallRecord {
  id                String   @id @default(cuid())
  unitedCloudCallId String   @unique
  direction         String
  fromLabel         String
  toLabel           String
  // Raw, CDR-sourced — not resolved to a company/tech name at sync time.
  // externalNumber is the far-end party's number (last 10 digits, NANP),
  // extracted from whichever CDR field holds it for that direction (the
  // orig-from-uri SIP URI for inbound, orig-to-user for outbound).
  // internalExtension is whichever of our own extensions handled the call
  // (call-term-user for inbound, call-orig-user for outbound) — for a
  // hunt-group call this may be the group's own pseudo-extension, not an
  // individual's. Both are null when the source field wasn't present.
  // Resolving these to a company name / tech name is done live at read
  // time (see lib/integrations/contactDirectory.ts) — company name against
  // HaloPSA contacts, tech name against United Cloud's own extension
  // directory — not baked in here, since that mapping can change
  // independently of call history.
  externalNumber    String?
  internalExtension String?
  startAt           DateTime
  answeredAt        DateTime?
  durationSeconds   Int
  missed            Boolean
  createdAt         DateTime @default(now())

  @@index([startAt])
}

// ---------------------------------------------------------------------------
// Device Health (NinjaRMM)
// ---------------------------------------------------------------------------

// One row per synced device. Unlike CDRs, /v2/devices returns the full
// current inventory every sync, so this reconciles like TicketSnapshot
// does — a device missing from a successful fetch gets deleted, not left
// stale. osName is best-effort (field not confirmed on the core device
// object, see lib/integrations/ninjaRmm.ts) until verified against a
// real response.
model NinjaDevice {
  id             String    @id @default(cuid())
  ninjaDeviceId  String    @unique
  displayName    String
  systemName     String?
  organizationId String?
  offline        Boolean
  lastContact    DateTime?
  osName         String?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  @@index([offline])
}

// One row per NinjaOne Remote session, built by grouping /v2/activities
// NINJA_REMOTE events sharing the same seriesUid — confirmed live: a
// session's lifecycle is "Remote control session requested" -> "Session
// started" -> "Session terminated" (or "Session failed to start" /
// "Cancel Requested" instead of a normal finish), all three carrying the
// identical seriesUid. durationSeconds comes straight from the
// terminated event's own params.duration (NinjaOne's own computed
// value, confirmed present) — not derived from endedAt-startedAt here,
// per the spec's "do not assume, verify" standard for this integration.
// ninjaDeviceId/ninjaUserId are raw NinjaOne IDs; device/org/tech names
// are resolved at read time (NinjaDevice join + a live /v2/organizations
// and /v2/users fetch, both small and unpersisted — same pattern
// fetchNinjaOrganizations already uses) rather than denormalized here,
// so a later rename doesn't leave this table stale.
model RemoteSession {
  id              String    @id @default(cuid())
  seriesUid       String    @unique
  ninjaDeviceId   String?
  ninjaUserId     String?
  requestedAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  // "completed" (has a terminated event) | "failed" (Session failed to
  // start) | "canceled" (Cancel Requested, never started) | "in_progress"
  // (started, no terminate event seen yet) | "requested_only" (only a
  // request event seen, nothing else — usually means the response page
  // hasn't caught the next event yet, not a real outcome).
  status          String
  lastUpdatedAt   DateTime  @default(now())

  @@index([startedAt])
  @@index([ninjaDeviceId])
}

// Singleton cursor for the /v2/activities scan (see fetchRemoteActivities
// in ninjaRmm.ts). Confirmed live: this account produces roughly 10,000
// activities/day account-wide (~95% monitor/patch noise, not remote
// sessions), so a full 30-day backward scan on every page load would
// need hundreds of thousands of requests — not viable. Instead each sync
// only pages back to the newest activity id already processed last time
// (cheap — a handful of pages for a few minutes' gap), and the
// RemoteSession table accumulates real depth over the app's actual
// runtime, same "never fake depth, build it up honestly" pattern as
// Call Answer Rate's monthly trend. The very first sync ever (no cursor
// yet) is bounded by ACTIVITIES_SYNC_WINDOW_DAYS/ACTIVITIES_MAX_PAGES
// instead, so history starts shallow rather than scanning unboundedly.
model NinjaActivitySyncState {
  id               String   @id @default("ninja-activities")
  newestActivityId Int
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Admin / KPI Settings (Phase 12)
// ---------------------------------------------------------------------------

// Singleton row (see lib/services/kpiSettings.ts's getKpiSettings — a
// get-or-create, not a plain findUnique) centralizing the score weights,
// sample-size minimums, and thresholds that were previously hardcoded
// module-level constants scattered across serviceDeskHealth.ts,
// techPerformanceScore.ts, callActivity.ts, remoteSessions.ts, and
// operations.ts (several of them literally duplicated byte-for-byte
// across two files). Every @default below matches the exact value that
// constant held before this table existed, so creating this row for the
// first time changes nothing until an admin actually edits a value via
// /admin. Deliberately NOT throttle-cached like getContactDirectory —
// this is a local SQLite primary-key read, not an external API call, and
// an admin's save should take effect on the very next page load.
model KpiSettings {
  id String @id @default("kpi-settings")

  // Service Desk Health Score weights — must sum to 100 (enforced by
  // updateKpiSettings, not by the schema itself; SQLite has no CHECK
  // constraint support in this Prisma setup). Matches BASE_WEIGHTS,
  // formerly serviceDeskHealth.ts.
  healthWeightResponsiveness Int @default(25)
  healthWeightResolution     Int @default(20)
  healthWeightWorkload       Int @default(20)
  healthWeightPhone          Int @default(15)

  // Technician Performance Score weights — same sum-to-100 rule.
  // Matches BASE_WEIGHTS, formerly techPerformanceScore.ts.
  techWeightServiceDelivery Int @default(30)
  techWeightQuality         Int @default(25)
  techWeightProductivity    Int @default(20)
  techWeightWorkManagement  Int @default(15)
  techWeightPhone           Int @default(10)

  // Sample-size minimums / lookback windows — formerly duplicated
  // identically across serviceDeskHealth.ts + techPerformanceScore.ts
  // (minSlaSample, resolutionWindowDays) and callActivity.ts +
  // remoteSessions.ts (minPercentileSample).
  minSlaSample         Int @default(5)
  resolutionWindowDays Int @default(30)
  minPercentileSample  Int @default(5)

  // Thresholds — formerly CALLBACK_TARGET_MINUTES (callActivity.ts) and
  // STALE_BUSINESS_HOURS (operations.ts).
  callbackTargetMinutes Int @default(15)
  staleBusinessHours    Int @default(24)

  // Client Profitability's true service cost = hoursThisMonth × this rate
  // (lib/integrations/quickbooks.ts's syncAllClientFinancials) — replaces
  // the old blended-payroll-÷-hours estimate, which the business never
  // directly controls and was only ever a guess at which QuickBooks
  // Purchase accounts are payroll. 0 means "not configured yet," not
  // "service is free" — callers treat <= 0 as unavailable and say so in
  // the UI rather than silently computing a $0 cost. Field name kept as
  // "labor" (not renamed to match the UI's "Service" label) to avoid a
  // migration for a pure display-text change — see
  // lib/services/clientProfitability.ts's own comment on this.
  laborHourlyRate Float @default(0)

  // Service-Desk-relevant SLA/status color bands (green-at-or-above,
  // yellow-at-or-above, red below yellow — see bandHigherIsBetter/
  // bandLowerIsBetter in lib/kpiStatus.ts). Aging is lower-is-better
  // (green at-or-below agingGreenCount). Business Health's own bands
  // (Gross Margin, Device Health, etc.) are a different page and stay
  // hardcoded — out of this phase's scope.
  responseSlaGreenPct   Int @default(90)
  responseSlaYellowPct  Int @default(75)
  resolutionSlaGreenPct Int @default(90)
  resolutionSlaYellowPct Int @default(75)
  agingGreenCount       Int @default(0)
  agingYellowCount      Int @default(4)
  answerRateGreenPct    Int @default(90)
  answerRateYellowPct   Int @default(80)

  updatedAt DateTime @updatedAt
}

// Matches the spec's "Technician Roles" framework — role affects
// THROUGHPUT_BAND in techPerformanceScore.ts (role-normalized
// productivity targets). A real Prisma enum (not a hand-written TS
// union, the pre-Phase-12 approach) so an invalid role value can't be
// written by a bug or a stray admin API payload — same enum-for-a-closed-
// set-of-labels convention as TicketPriority above.
enum TechRole {
  SERVICE_DESK_TECHNICIAN
  SENIOR_TECHNICIAN
  ESCALATION_ENGINEER
  PROJECT_ENGINEER
  SERVICE_DESK_MANAGER
  HYBRID
}

// One row per known tech (see KNOWN_TECHS, lib/integrations/halopsa.ts —
// the roster itself stays a compile-time TS union, only the role/hours
// assigned to each known name become admin-editable here). Replaces the
// hardcoded TECH_ROLES map (techPerformanceScore.ts) and the flat
// EXPECTED_WEEKLY_HOURS = 40 constant (halopsa.ts) — expectedWeeklyHours
// is now genuinely per-tech rather than uniform for everyone.
// getTechRoleConfigs() ensures a row exists per KNOWN_TECHS member with
// these defaults, same "small per-person table, upsert on demand" pattern
// as DailyHours/TechScoreDaily.
model TechRoleConfig {
  id                  String   @id @default(cuid())
  person              String   @unique
  role                TechRole @default(SERVICE_DESK_TECHNICIAN)
  expectedWeeklyHours Float    @default(40)
  updatedAt           DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Staff Login & Access Control
// ---------------------------------------------------------------------------

// App-access permission level — deliberately a separate enum/name from
// TechRole above (that's a performance-scoring tier, e.g. junior/senior;
// this is "what can this signed-in person open"). SDR is reserved for
// the future CRM/Sales area — no page is gated to it yet.
enum AppRole {
  TECHNICIAN
  SERVICE_MANAGER
  CEO
  SDR
}

// One row per person who has ever signed in with Microsoft 365 (see
// lib/auth/staffSession.ts). role is nullable: a brand-new sign-in
// exists here but can't see anything until a CEO assigns one via
// /admin/users — except the very first sign-in ever, which becomes CEO
// automatically (someone has to be able to get in and assign everyone
// else). techPerson links to KNOWN_TECHS (lib/integrations/halopsa.ts)
// when role = TECHNICIAN, so their /tech-performance view can be
// filtered to just their own card.
model StaffUser {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  role        AppRole?
  techPerson  String?
  // Relative filename under data/avatars/ (see lib/services/avatars.ts) —
  // not a URL column, since these are role-gated local files, same
  // storage convention as SopFile.storagePath. Includes a random suffix
  // per upload so replacing a picture naturally busts any cached <img>.
  avatarPath  String?
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  delegatedInboxItems InboxItem[]
}

// SOP tracking (Phase B of the staff login/RBAC work) — structured
// entries authored in-app — a title + description (body) plus one or
// more attached files (SopFile below; Word for drafts, PDF for final,
// distinguished by extension, not a separate status field). roles is a
// comma-separated list of AppRole values (SQLite has no native array
// column type — same serialized-list pattern this schema already uses
// elsewhere, e.g. TicketSnapshot.ticket_tags), read by
// lib/services/sops.ts. taskArea is deliberately free text, not a
// rigid enum — the set of task areas isn't known/fixed up front.
model SopEntry {
  id        String     @id @default(cuid())
  title     String
  body      String
  taskArea  String?
  roles     String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  files     SopFile[]
}

// One uploaded file per row, many per SopEntry. storagePath is relative
// to data/sop-files/ (see lib/services/sopFiles.ts) — files live on
// local disk, same "local-first" pattern as the SQLite DB itself
// (data/dev.db), never in public/ (that's served unauthenticated by
// Next.js directly, and these are role-gated — see
// app/api/sops/[id]/files/[fileId]/route.ts for the actual boundary).
model SopFile {
  id         String   @id @default(cuid())
  sopEntryId String
  sopEntry   SopEntry @relation(fields: [sopEntryId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  sizeBytes  Int
  storagePath String
  createdAt  DateTime @default(now())

  @@index([sopEntryId])
}

// ---------------------------------------------------------------------------
// Vendor Subscriptions
// ---------------------------------------------------------------------------

// Manually-tracked vendor license/subscription renewal dates — for
// vendors with no API exposing this data (confirmed earlier: Huntress,
// DNSFilter, Bitdefender, AutoElevate, Cove Data Protection all keep
// renewal info in email, not any queryable endpoint). productName is
// deliberately free text rather than a separate structured quantity +
// unit — real examples ("500 endpoints", "50 identities") use different
// units per product, so a rigid field wouldn't fit cleanly; the human-
// readable string already carries what matters. CEO-only, same as
// Client Profitability — see app/vendors/page.tsx.
model VendorSubscription {
  id          String   @id @default(cuid())
  vendorName  String
  productName String
  renewalDate DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([renewalDate])
}
